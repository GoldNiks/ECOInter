# Local API binding
HOST=127.0.0.1
PORT=3000

# ECOInter automatically creates data/master.key on first run.
# Set this only if you want to provide your own passphrase instead.
# Keep it private and do not commit it.
ECOINTER_MASTER_KEY=

# Optional paths (defaults shown)
DATABASE_PATH=./data/ecointer.sqlite
# ECOINTER_KEY_FILE=./data/master.key
