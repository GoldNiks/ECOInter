# Local API binding
HOST=127.0.0.1
PORT=3000

# Keep this key OUTSIDE the database and source control.
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ECOINTER_MASTER_KEY=

# Optional database location (default: ./data/ecointer.sqlite)
DATABASE_PATH=./data/ecointer.sqlite
